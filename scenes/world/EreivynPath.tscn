[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

const REGION := \"ereivyn\"

func _ready() -> void:
	print(\"[EreivynPath] Ready\")
	if not GlobalFlags.get_flag(\"reached_ereivyn\"):
		GlobalFlags.set_flag(\"reached_ereivyn\", true)
	_connect_enemies()
	await get_tree().create_timer(0.5).timeout
	if not GlobalFlags.get_flag(\"ereivyn_threshold_dialogue_done\"):
		GlobalFlags.set_flag(\"ereivyn_threshold_dialogue_done\", true)
		DialogueManager.start_dialogue(\"scene_04_ereivyn_threshold\")
	else:
		_check_story_triggers()

func _check_story_triggers() -> void:
	var dialogue_id := StoryTriggerSystem.check_triggers(REGION)
	if dialogue_id != \"\":
		await get_tree().create_timer(0.5).timeout
		DialogueManager.start_dialogue(dialogue_id)

func _connect_enemies() -> void:
	for enemy in get_tree().get_nodes_in_group(\"overworld_enemies\"):
		if not enemy.player_contacted.is_connected(_on_enemy_contact):
			enemy.player_contacted.connect(_on_enemy_contact)

func _on_enemy_contact(enemy: CharacterBody2D) -> void:
	if get_tree().root.has_node(\"BattleTransition\"):
		BattleTransition.start_transition(enemy)
"


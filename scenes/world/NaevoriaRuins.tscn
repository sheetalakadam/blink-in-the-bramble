[sub_resource type="GDScript" id="GDScript_1"]
script/source = "extends Node2D

func _ready() -> void:
	print(\"[NaevoriaRuins] Ready\")
	if not GlobalFlags.get_flag(\"reached_naevoria\"):
		GlobalFlags.set_flag(\"reached_naevoria\", true)
	_connect_enemies()
	await get_tree().create_timer(1.0).timeout
	if not GlobalFlags.get_flag(\"opening_dialogue_done\"):
		GlobalFlags.set_flag(\"opening_dialogue_done\", true)
		if DialogueManager:
			DialogueManager.start_dialogue(\"scene_01_the_fall\")
			if DialogueManager.has_signal(\"dialogue_finished\"):
				await DialogueManager.dialogue_finished
			_on_opening_dialogue_complete()
		else:
			printerr(\"[NaevoriaRuins] DialogueManager not found!\")
			_on_opening_dialogue_complete()

func _on_opening_dialogue_complete() -> void:
	if not GlobalFlags.get_flag(\"caelan_joined\"):
		GlobalFlags.set_flag(\"caelan_joined\", true)
		var caelan = load(\"res://data/characters/caelan.tres\") as CharacterData
		if caelan:
			PartyManager.add_to_party(caelan)
			print(\"[NaevoriaRuins] Caelan has joined the party.\")

func _connect_enemies() -> void:
	for enemy in get_tree().get_nodes_in_group(\"overworld_enemies\"):
		if not enemy.player_contacted.is_connected(_on_enemy_contact):
			enemy.player_contacted.connect(_on_enemy_contact)

func _on_enemy_contact(enemy: CharacterBody2D) -> void:
	if Engine.has_singleton(\"BattleTransition\") or get_tree().root.has_node(\"BattleTransition\"):
		BattleTransition.start_transition(enemy)
	else:
		print(\"[NaevoriaRuins] BattleTransition not found, enemy contact ignored\")
"

